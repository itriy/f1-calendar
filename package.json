{
  "name": "f1-calendar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run dev:db && (npm run dev:assets & wrangler dev --local --port 8787)",
    "dev:db": "wrangler d1 migrations apply f1-calendar-push --local",
    "dev:assets": "vite build --watch",
    "dev:vite": "vite",
    "dev:worker": "npm run build && wrangler dev --local --port 8787",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:fix": "prettier --write \"**/*.{css,html,js,json,ts,vue}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && tsx scripts/generate-seo-pages.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:db": "wrangler d1 migrations apply f1-calendar-push --remote"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@mmmike/web-push": "^1.3.0",
    "@vitejs/plugin-vue": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-i18n": "^11.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.125.0",
    "prettier": "^3.5.3"
  }
}
