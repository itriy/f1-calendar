{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-calendar",
  "compatibility_date": "2026-08-23",
  "main": "src/server/worker.ts",
  "durable_objects": {
    "bindings": [{ "name": "F1_LIVE", "class_name": "F1LiveTimingHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["F1LiveTimingHub"] }],
  "d1_databases": [
    {
      "binding": "PUSH_DB",
      "database_name": "f1-calendar-push",
      "database_id": "647b3726-f229-47ac-a3a8-03567a916c3e",
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
}
