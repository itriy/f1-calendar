{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-calendar",
  "compatibility_date": "2026-08-23",
  "main": "src/worker.ts",
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
