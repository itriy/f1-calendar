{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-calendar",
  "compatibility_date": "2026-08-23",
  "main": "src/server/worker.ts",
  "d1_databases": [
    {
      "binding": "PUSH_DB",
      "database_name": "f1-calendar-push",
      "database_id": "647b3726-f229-47ac-a3a8-03567a916c3e"
    }
  ],
  "vars": {
    "VAPID_PUBLIC_KEY": "BOxno_f1JsbnQMguGrqnn6Zd_FZCL_O4TRtL70ZVRyoK85_bAoJPHeH4-rW-eChK2dk-PJ0A4zwHF0DP26w8F1Y",
    "VAPID_SUBJECT": "mailto:itriy1@gmail.com"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
